# PostgreSQL connection string (required for anything that persists: auth, chats, project files).
# Local default used by drizzle.config.ts if you run Postgres the usual way.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Optional. Without it DeepThink runs the built-in offline demo agent — the whole
# plan / write / build-check loop still streams, it just isn't DeepSeek answering.
DEEPSEEK_API_KEY=

# Optional. Only set this to point at an OpenAI-compatible proxy.
# Defaults to https://api.deepseek.com/v1/chat/completions
# DEEPSEEK_API_URL=
